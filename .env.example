# Copie este arquivo para .env e preencha com suas credenciais reais.
# O arquivo .env NUNCA deve ser commitado (já está no .gitignore).

# Google Gemini API (gratuito — https://aistudio.google.com/apikey)
GEMINI_API_KEY=AIza...

# Gmail — use uma App Password, não a senha da conta.
# Para gerar: https://myaccount.google.com/apppasswords
GMAIL_USER=seu_email@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Destinatário do e-mail
EMAIL_DESTINATARIO=lucas.ribeiro.lima@edu.sc.senai.br
